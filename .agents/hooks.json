{
  "harness-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^(run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|read_file|view_file|grep_search)$",
        "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness/hook.mjs\" agy pre-tool", "timeout": 20 }]
      }
    ]
  },
  "harness-context": {
    "enabled": true,
    "SessionStart": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness/hook.mjs\" agy session-start", "timeout": 30 }]
  }
}
