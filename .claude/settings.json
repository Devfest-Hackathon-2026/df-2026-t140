{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(npm run work *)",
      "Bash(npm run human *)",
      "Bash(npm run check:harness *)",
      "Bash(npm run test:harness *)",
      "Bash(npm run review-pack *)",
      "Bash(npm run trace *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm run verify *)",
      "Bash(node scripts/harness/*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(firebase deploy *)",
      "Bash(npm run deploy *)",
      "Bash(npm run smoke:prod *)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/web/.env)",
      "Read(/web/.env.local)",
      "Read(/functions/.env.local)",
      "Read(/**/service-account*.json)",
      "Edit(/.local/**)",
      "Write(/.local/**)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Write(/**/.env)",
      "Write(/**/.env.local)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/scripts/harness/hook.mjs", "claude", "prompt"], "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/scripts/harness/hook.mjs", "claude", "session-start"], "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/scripts/harness/hook.mjs", "claude", "pre-tool"], "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/scripts/harness/hook.mjs", "claude", "post-edit"], "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/scripts/harness/hook.mjs", "claude", "stop"], "timeout": 15 }
        ]
      }
    ]
  }
}
