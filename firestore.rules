rules_version = '2';

// データの形は web/src/entities/<データ>/model/types.ts と functions/src/domain/<データ>.ts、
// 確認は scripts/smoke.mjs。そろえて変える。
//
// 書ける人（技術構成の「参加と権限」）
//   各端末        旅行、自分のメンバー情報、希望、自分の投票（本人とメンバーに限定）
//   Functions だけ ピン、ルート案、模型の JSON、旅行の状態と決定したルート（Admin SDK はルールを通らない）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function memberPath(tripId, uid) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(uid);
    }

    function votePath(tripId, routeId, uid) {
      return /databases/$(database)/documents/trips/$(tripId)/routes/$(routeId)/votes/$(uid);
    }

    function isMember(tripId) {
      return signedIn() && exists(memberPath(tripId, request.auth.uid));
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // パスに埋め込むので、ID に使える文字だけを通す
    function isId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function validTripInfo(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 40
        && isDate(data.startDate)
        && (data.endDate == null || (isDate(data.endDate) && data.endDate >= data.startDate))
        && data.origin is string && data.origin.size() >= 1 && data.origin.size() <= 40;
    }

    // 大まかな場所（地方）。作るときだけ書ける（あとから変えられるかは決めていない。企画書「決めていないこと」）。
    // 前からある画面（地方を選ぶ前の版）でも作れるように、なくてもよい。ID は web/src/entities/trip/model/regions.ts と合わせる
    function validRegions(data) {
      return !('regions' in data) || (data.regions is list
        && data.regions.size() >= 1 && data.regions.size() <= 11
        && data.regions.toSet().size() == data.regions.size()
        && data.regions.hasOnly(['hokkaido', 'tohoku', 'kanto', 'koshinetsu', 'hokuriku', 'tokai', 'kinki', 'chugoku', 'shikoku', 'kyushu', 'okinawa']));
    }

    // 県まで絞ったときだけの、選んだ県の名前。地方と同じく作るときだけ書ける。web/src/entities/trip/model/regions.ts と合わせる
    function validPrefectures(data) {
      return !('prefectures' in data) || (data.prefectures is list
        && data.prefectures.size() >= 1 && data.prefectures.size() <= 47
        && data.prefectures.toSet().size() == data.prefectures.size()
        && data.prefectures.hasOnly(['北海道', '青森県', '岩手県', '宮城県', '秋田県', '山形県', '福島県', '茨城県', '栃木県', '群馬県', '埼玉県', '千葉県', '東京都', '神奈川県', '新潟県', '富山県', '石川県', '福井県', '山梨県', '長野県', '岐阜県', '静岡県', '愛知県', '三重県', '滋賀県', '京都府', '大阪府', '兵庫県', '奈良県', '和歌山県', '鳥取県', '島根県', '岡山県', '広島県', '山口県', '徳島県', '香川県', '愛媛県', '高知県', '福岡県', '佐賀県', '長崎県', '熊本県', '大分県', '宮崎県', '鹿児島県', '沖縄県']));
    }

    function validOriginPoint(data) {
      return !('originPoint' in data) || (data.originPoint is map
        && data.originPoint.keys().hasOnly(['name', 'location', 'placeId'])
        && data.originPoint.keys().hasAll(['name', 'location', 'placeId'])
        && data.originPoint.name == data.origin
        && data.originPoint.location is map
        && data.originPoint.location.keys().hasOnly(['lat', 'lng'])
        && data.originPoint.location.lat is number && data.originPoint.location.lat >= -90 && data.originPoint.location.lat <= 90
        && data.originPoint.location.lng is number && data.originPoint.location.lng >= -180 && data.originPoint.location.lng <= 180
        && (data.originPoint.placeId == null || (data.originPoint.placeId is string && data.originPoint.placeId.size() <= 300)));
    }

    // 旅の最後にいたい場所（帰る場所）。出発地と違うときだけ、作るときに書ける（Takana の依頼、2026-11-22）。
    // 名前と位置はそろえて書く。位置の形は出発地（validOriginPoint）と同じ
    function validReturnPoint(data) {
      return (!('returnTo' in data) && !('returnPoint' in data)) || (data.returnTo is string
        && data.returnTo.size() >= 1 && data.returnTo.size() <= 40
        && data.returnTo != data.origin
        && data.returnPoint is map
        && data.returnPoint.keys().hasOnly(['name', 'location', 'placeId'])
        && data.returnPoint.keys().hasAll(['name', 'location', 'placeId'])
        && data.returnPoint.name == data.returnTo
        && data.returnPoint.location is map
        && data.returnPoint.location.keys().hasOnly(['lat', 'lng'])
        && data.returnPoint.location.lat is number && data.returnPoint.location.lat >= -90 && data.returnPoint.location.lat <= 90
        && data.returnPoint.location.lng is number && data.returnPoint.location.lng >= -180 && data.returnPoint.location.lng <= 180
        && (data.returnPoint.placeId == null || (data.returnPoint.placeId is string && data.returnPoint.placeId.size() <= 300)));
    }

    function validMemberProfile(data) {
      return data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 20
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$');
    }

    function validBounds(bounds) {
      return bounds.keys().hasOnly(['north', 'south', 'east', 'west'])
        && bounds.keys().hasAll(['north', 'south', 'east', 'west'])
        && bounds.north is number && bounds.north >= -90 && bounds.north <= 90
        && bounds.south is number && bounds.south >= -90 && bounds.south <= 90
        && bounds.east is number && bounds.east >= -180 && bounds.east <= 180
        && bounds.west is number && bounds.west >= -180 && bounds.west <= 180;
    }

    // 旅程が確定しているか（features/confirm-shiori）。確定しているあいだは、行きたいことを足せず、旅の名前と日程も変えられない
    function isConfirmed(tripId) {
      return 'confirmed' in get(tripPath(tripId)).data;
    }

    function isPlanning(tripId) {
      return get(tripPath(tripId)).data.status == 'planning';
    }

    // 投票の記録（votes）と members の votedRouteId は、同じ書き込みの中で必ずそろえる。
    // これで 1 人 1 票になる。票を変えるときは、古い票の削除、新しい票の作成、votedRouteId の更新を 1 回で行う。
    // 票を入れる、変える、取り消すのは計画中だけ。決定したあとは、決め手になった票を動かせない。
    function voteMovedCorrectly(tripId, uid, before, after) {
      return before == after
        || (isPlanning(tripId)
          && (after == null || (isId(after) && existsAfter(votePath(tripId, after, uid))))
          && (before == null || !existsAfter(votePath(tripId, before, uid))));
    }

    // 旅の一覧用。自分のメンバー情報だけを、旅をまたいで集められる（collection group）。
    // 問い合わせには where('uid', '==', 自分) が要る。
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      // 一覧（list）は許さない。旅行 ID を知っていて、メンバーである人だけが読める
      allow get: if isMember(tripId);

      // 作る人は、同じ書き込みで自分をメンバーに入れる
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['title', 'startDate', 'endDate', 'origin', 'originPoint', 'returnTo', 'returnPoint', 'regions', 'prefectures', 'travelMode', 'status', 'decidedRouteId', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
          ['title', 'startDate', 'endDate', 'origin', 'status', 'decidedRouteId', 'createdBy', 'createdAt', 'updatedAt'])
        && validTripInfo(request.resource.data)
        && validOriginPoint(request.resource.data)
        && validReturnPoint(request.resource.data)
        && validRegions(request.resource.data)
        && validPrefectures(request.resource.data)
        // 移動手段（車、電車・バス、飛行機）。選び直すのは Functions だけ（features/change-travel-mode。しおりの時刻を一緒に計算し直すため）
        && (!('travelMode' in request.resource.data) || request.resource.data.travelMode in ['car', 'transit', 'plane'])
        && request.resource.data.status == 'planning'
        && request.resource.data.decidedRouteId == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(memberPath(tripId, request.auth.uid));

      // メンバーなら誰でも旅の名前を直せる（幹事だけにしない）。日程は発案者だけが Functions（change-trip-dates）で変える
      // （しおりの組み直しと一緒に行うため。2026-11-22）。状態と決定したルート、旅程の確定（confirmed）も Functions だけ。
      // 旅程が確定しているあいだは直せない
      allow update: if isMember(tripId)
        && !('confirmed' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['title', 'updatedAt'])
        && validTripInfo(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      match /members/{uid} {
        // 自分の分は、参加前でも「まだメンバーではない」と分かるように読める
        allow get: if signedIn() && (request.auth.uid == uid || isMember(tripId));
        allow list: if isMember(tripId);

        // 招待 URL（旅行 ID）を知っていれば、自分を足して参加できる
        allow create: if signedIn()
          && request.auth.uid == uid
          && existsAfter(tripPath(tripId))
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'color', 'votedRouteId', 'joinedAt'])
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'color', 'votedRouteId', 'joinedAt'])
          && request.resource.data.uid == uid
          && validMemberProfile(request.resource.data)
          && request.resource.data.votedRouteId == null
          && request.resource.data.joinedAt == request.time;

        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'color', 'votedRouteId'])
          && validMemberProfile(request.resource.data)
          && voteMovedCorrectly(tripId, uid, resource.data.votedRouteId, request.resource.data.votedRouteId);

        // 旅から抜ける。票が残らないよう、投票済みなら同じ書き込みで票も消す
        allow delete: if signedIn()
          && request.auth.uid == uid
          && (resource.data.votedRouteId == null
            || !existsAfter(votePath(tripId, resource.data.votedRouteId, uid)));
      }

      match /wishes/{wishId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && !isConfirmed(tripId)
          // lodgingNight は、しおりの「宿を探す」から書いた希望にだけある（何日目の夜の宿か。整数かどうかは Functions が見る。domain/wish.ts）
          // mealSlot は、しおりのごはんの枠の「お店を探す」から書いた希望にだけある（「1-lunch」の形。domain/meal.ts）
          && request.resource.data.keys().hasOnly(['uid', 'text', 'bounds', 'status', 'createdAt', 'lodgingNight', 'mealSlot'])
          && request.resource.data.keys().hasAll(['uid', 'text', 'bounds', 'status', 'createdAt'])
          && (!('lodgingNight' in request.resource.data)
            || (request.resource.data.lodgingNight is number && request.resource.data.lodgingNight >= 1 && request.resource.data.lodgingNight <= 30))
          && (!('mealSlot' in request.resource.data)
            || (request.resource.data.mealSlot is string && request.resource.data.mealSlot.matches('^([1-9]|[12][0-9]|3[01])-(breakfast|lunch|dinner)$')))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 100
          && (request.resource.data.bounds == null || validBounds(request.resource.data.bounds))
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      }

      // ピンと模型は Functions だけが書く（AI の結果を改ざんさせない）
      match /pins/{pinId} {
        allow read: if isMember(tripId);

        match /model/{modelId} {
          allow read: if isMember(tripId);
        }
      }

      // ルート案は Functions だけが書く
      match /routes/{routeId} {
        allow read: if isMember(tripId);

        match /votes/{uid} {
          allow read: if isMember(tripId);

          // 計画中だけ投票できる。members の votedRouteId も同じ書き込みでこのルートにする
          allow create: if isMember(tripId)
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
            && request.resource.data.keys().hasAll(['uid', 'createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/trips/$(tripId)/routes/$(routeId))
            && isPlanning(tripId)
            && getAfter(memberPath(tripId, uid)).data.votedRouteId == routeId;

          // 消せるのは、旅から抜けるとき（いつでも）と、計画中に票を変える・取り消すときだけ
          allow delete: if signedIn()
            && request.auth.uid == uid
            && (!existsAfter(memberPath(tripId, uid))
              || (isPlanning(tripId) && getAfter(memberPath(tripId, uid)).data.votedRouteId != routeId));
        }
      }
    }

    // 合言葉を通した人の記録。書くのは Functions だけ（features/unlock-ai が合言葉を通したとき、features/move-memberships が
    // Google アカウントへの引き継ぎで前の自分の記録を写すとき）。本人だけが読める（画面で「本物の AI が使える」と出す）
    match /aiAccess/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // ここに書いていないもの（modelCache、usage など）はすべて拒否される
  }
}
